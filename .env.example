# Mailbox that receives enquiries (comma-separate for several recipients)
CONTACT_TO_EMAIL=recipient@example.com

# --- Option 1: send FROM a Gmail account (used when both are set) ---
# SMTP_PASS must be a Google "App password" (Google Account > Security > 2-Step Verification > App passwords),
# NOT the normal Gmail password.
SMTP_USER=sender@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# --- Option 2: Resend (used only if SMTP_USER/SMTP_PASS are not set) ---
# Resend cannot send from @gmail.com; it needs a verified domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL=SmartGrowApp <onboarding@resend.dev>

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shown on the website (Contact page and footer). Leave blank to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
