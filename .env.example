# Resend API key (https://resend.com/api-keys). Server-side only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Mailbox that receives enquiries (comma-separate for several recipients)
CONTACT_TO_EMAIL=enquiries@example.com

# Verified sender, e.g. "SmartGrowApp <no-reply@your-verified-domain.com>"
# For quick tests Resend allows: "SmartGrowApp <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=SmartGrowApp <onboarding@resend.dev>

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shown on the website (Contact page and footer). Leave blank to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
